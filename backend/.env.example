# ─── Copia este archivo como .env y completa los valores ─────────────────────
# NUNCA subas el .env real a git.
#
# USO LOCAL (sin AWS):
#   - Completa solo la sección "LOCAL" y deja las secciones AWS vacías.
#   - Los microservicios arrancan en modo sin seguridad JWT (puerto abierto).
#
# USO AWS:
#   - Completa todas las secciones.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# LOCAL — RabbitMQ (Docker Compose)
# ══════════════════════════════════════════════════════════════════════════════
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# URL de la Management API de RabbitMQ (usada por ms-rabbit-admin)
RABBITMQ_ADMIN_URL=http://localhost:15672/api
RABBITMQ_ADMIN_USER=guest
RABBITMQ_ADMIN_PASSWORD=guest

# ══════════════════════════════════════════════════════════════════════════════
# LOCAL — Base de datos MySQL
# Puede ser MySQL local o el endpoint de Aurora con acceso desde Workbench
# ══════════════════════════════════════════════════════════════════════════════

# --- ms-pedidos (puerto 8082) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=pedidos360_pedidos
# DB_USER=root
# DB_PASSWORD=TU_CLAVE_LOCAL

# --- ms-productos (puerto 8081) ---
# Nota: cada microservicio usa su propia DB; al arrancarlos en terminales
# separadas, configura DB_NAME distinto en cada una (o usa perfiles Spring).
# DB_NAME=pedidos360_productos

# ══════════════════════════════════════════════════════════════════════════════
# AWS — Aurora MySQL (completar cuando se cree la instancia)
# ══════════════════════════════════════════════════════════════════════════════
# DB_HOST=<endpoint-aurora>.cluster-xxxx.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=REEMPLAZAR_POR_CLAVE_AURORA
# DB_USE_SSL=true

# ══════════════════════════════════════════════════════════════════════════════
# AWS — Cognito (completar cuando se configure el nuevo User Pool)
# ══════════════════════════════════════════════════════════════════════════════
# Formato: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json
# JWK_SET_URI=

# ══════════════════════════════════════════════════════════════════════════════
# AWS — Cluster RabbitMQ (solo para EC2, ignorar en local)
# Genera la cookie con: openssl rand -base64 32
# ══════════════════════════════════════════════════════════════════════════════
# RABBITMQ_ERLANG_COOKIE=REEMPLAZAR_POR_COOKIE_SECRETA_LARGA

# ══════════════════════════════════════════════════════════════════════════════
# URL de ms-productos (usada por ms-pedidos para consultar stock/precio)
# LOCAL: http://localhost:8081
# AWS EC2: http://localhost:8081 (si están en la misma máquina) o IP privada
# ══════════════════════════════════════════════════════════════════════════════
PRODUCTOS_SERVICE_URL=http://localhost:8081
